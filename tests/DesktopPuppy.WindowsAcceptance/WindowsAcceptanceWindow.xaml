<Window x:Class="DesktopPuppy.WindowsAcceptance.WindowsAcceptanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Puppy Windows acceptance" Width="720" Height="590" MinWidth="600" MinHeight="520">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Windows session and power acceptance" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
      <TextBlock Text="Manual, opt-in acceptance only. No button locks or sleeps the machine. Task 2 launches isolated targets and observes real notifications, but cannot pass either scenario until later manual steps and persisted-boundary checks are implemented." TextWrapping="Wrap" Margin="0,0,0,14"/>
      <TextBlock Text="Purpose: verify product usage-session boundaries across real Windows transitions." TextWrapping="Wrap"/>
      <TextBlock Text="Coverage: manual lock/unlock or suspend/resume, then foreground changes between fixtures." TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Text="Target effect: fixture A is the required first target; fixture B closes the resumed session. Do not begin the system transition until fixture A is foreground." TextWrapping="Wrap" Margin="0,4,0,16"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button x:Name="LockScenario" Content="Run lock/unlock acceptance" Click="ChooseLock" Margin="0,0,12,0" Padding="10,6"/>
        <Button x:Name="PowerScenario" Content="Run suspend/resume acceptance" Click="ChoosePower" Padding="10,6"/>
      </StackPanel>
      <TextBlock x:Name="Instructions" Text="Choose a scenario to view its manual instructions." TextWrapping="Wrap" Margin="0,0,0,16"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Button x:Name="BeginButton" Content="Begin" Click="Begin" IsEnabled="False" Padding="12,6" Margin="0,0,12,0"/>
        <Button x:Name="CompleteButton" Content="I have completed the step" Click="Complete" IsEnabled="False" Padding="12,6" Margin="0,0,12,0"/>
        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel" IsEnabled="False" Padding="12,6"/>
      </StackPanel>
      <TextBlock Text="Result state" FontWeight="Bold"/>
      <TextBlock x:Name="ResultState" Text="Not started" FontSize="18" Margin="0,4,0,8"/>
      <TextBlock x:Name="ResultDetail" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</Window>

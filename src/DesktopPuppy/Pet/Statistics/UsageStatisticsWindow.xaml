<Window x:Class="DesktopPuppy.Pet.Statistics.UsageStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopPuppy.Pet.Statistics"
        Title="使用统计"
        AutomationProperties.AutomationId="UsageStatisticsWindow"
        AutomationProperties.Name="使用统计窗口"
        Width="860"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="False"
        Loaded="Window_OnLoaded"
        Activated="Window_OnActivated"
        Closed="Window_OnClosed">
    <Window.Resources>
        <local:ElapsedDurationConverter x:Key="ElapsedDurationConverter" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1E293B" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Background="#FFF1F5F9" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF0F172A" Padding="24,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="使用统计"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="查看最近 15 天的应用与窗口标题使用时长"
                               Margin="0,4,0,0"
                               Foreground="#FFCBD5E1"
                               FontSize="13" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="选择日期"
                               Foreground="#FFCBD5E1"
                               FontSize="12"
                               HorizontalAlignment="Right" />
                    <ComboBox x:Name="DateSelector"
                              AutomationProperties.AutomationId="StatisticsDateSelector"
                              AutomationProperties.Name="统计日期"
                              Width="170"
                              Margin="0,5,0,0"
                              Padding="8,5"
                              ItemsSource="{Binding AvailableDates}"
                              SelectedItem="{Binding SelectedDate, Mode=OneWay}"
                              SelectionChanged="DateSelector_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0:yyyy-MM-dd}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="当日总时长" Foreground="#FF64748B" FontSize="13" />
                        <TextBlock AutomationProperties.AutomationId="StatisticsTotalDuration"
                                   AutomationProperties.Name="{Binding Statistics.TotalDuration, Converter={StaticResource ElapsedDurationConverter}}"
                                   AutomationProperties.HelpText="当日总时长"
                                   Margin="0,4,0,0"
                                   Foreground="#FF0F172A"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Text="{Binding Statistics.TotalDuration, Converter={StaticResource ElapsedDurationConverter}}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock AutomationProperties.AutomationId="StatisticsLoadingState"
                                   AutomationProperties.Name="统计加载状态"
                                   Text="正在加载统计数据……"
                                   Foreground="#FF2563EB"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock AutomationProperties.AutomationId="StatisticsEmptyState"
                                   AutomationProperties.Name="统计空状态"
                                   Text="这一天还没有使用记录。"
                                   Foreground="#FF64748B"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                                <Condition Binding="{Binding ErrorMessage}" Value="{x:Null}" />
                                                <Condition Binding="{Binding Statistics.Applications.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock AutomationProperties.AutomationId="StatisticsErrorState"
                                   AutomationProperties.Name="{Binding ErrorMessage}"
                                   AutomationProperties.HelpText="统计错误状态"
                                   MaxWidth="430"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="#FFB91C1C"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}"
                               Text="应用排行" />
                    <ListBox x:Name="ApplicationList"
                             AutomationProperties.AutomationId="StatisticsApplicationList"
                             AutomationProperties.Name="应用使用排行"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Statistics.Applications}"
                             SelectedItem="{Binding SelectedApplication, Mode=OneWay}"
                             SelectionChanged="ApplicationList_OnSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ProcessName}"
                                               FontWeight="SemiBold"
                                               Foreground="#FF1E293B" />
                                    <TextBlock Grid.Column="1"
                                               Margin="14,0,0,0"
                                               Text="{Binding Duration, Converter={StaticResource ElapsedDurationConverter}}"
                                               Foreground="#FF475569" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,3"
                                   Text="窗口标题明细" />
                        <TextBlock Text="{Binding SelectedApplication.ProcessName, TargetNullValue=请选择一个应用}"
                                   Foreground="#FF64748B"
                                   FontSize="13" />
                    </StackPanel>
                    <ListBox AutomationProperties.AutomationId="StatisticsTitleList"
                             AutomationProperties.Name="窗口标题使用明细"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding SelectedApplication.WindowTitles}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding WindowTitle}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#FF1E293B"
                                               ToolTip="{Binding WindowTitle}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="14,0,0,0"
                                               Text="{Binding Duration, Converter={StaticResource ElapsedDurationConverter}}"
                                               Foreground="#FF475569" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

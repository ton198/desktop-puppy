<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopPuppy.Pet.Statistics" x:Class="DesktopPuppy.Pet.Statistics.UsageStatisticsWindow" Title="使用统计" AutomationProperties.AutomationId="UsageStatisticsWindow" AutomationProperties.Name="使用统计窗口" Width="940" Height="720" MinWidth="720" MinHeight="540" Style="{StaticResource CottageWindow}" WindowStartupLocation="CenterScreen" Loaded="Window_OnLoaded" Activated="Window_OnActivated" Closed="Window_OnClosed">
    <Window.Resources>
        <local:ElapsedDurationConverter x:Key="ElapsedDurationConverter"/>
        <local:ApplicationShareConverter x:Key="ApplicationShareConverter"/>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="ShareBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="{StaticResource CanvasBrush}" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#ADC1A5" CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="使用统计" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="查看最近 15 天的应用使用情况。" Style="{StaticResource Hint}" Margin="0,6,16,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="选择日期" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DateSelector" AutomationProperties.AutomationId="StatisticsDateSelector" AutomationProperties.Name="统计日期" Width="166" ItemsSource="{Binding AvailableDates}" SelectedItem="{Binding SelectedDate, Mode=OneWay}" SelectionChanged="DateSelector_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0:yyyy-MM-dd}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,16">
            <StackPanel>
                <Grid Grid.Row="1" Margin="24,20,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="18" Background="{StaticResource AccentSoftBrush}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="当日使用时长" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}" AutomationProperties.AutomationId="StatisticsTotalDuration" AutomationProperties.Name="{Binding Statistics.TotalDuration, Converter={StaticResource ElapsedDurationConverter}, FallbackValue=—}" AutomationProperties.HelpText="当日总时长" Text="{Binding Statistics.TotalDuration, Converter={StaticResource ElapsedDurationConverter}, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="应用切换" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource MetricValue}" AutomationProperties.AutomationId="StatisticsSwitchCount" Text="{Binding Facts.ApplicationSwitchCount, StringFormat={}{0} 次, TargetNullValue=—, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="最长连续使用" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource MetricValue}" AutomationProperties.AutomationId="StatisticsLongestDuration" Text="{Binding Facts.LongestContinuousDuration, Converter={StaticResource ElapsedDurationConverter}, FallbackValue=—}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="2" Margin="24,12,24,0">
                    <TextBlock AutomationProperties.AutomationId="StatisticsLoadingState" AutomationProperties.Name="统计加载状态" Text="正在加载统计数据……" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock AutomationProperties.AutomationId="StatisticsEmptyState" AutomationProperties.Name="统计空状态" Text="这一天还没有使用记录。" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            <Condition Binding="{Binding ErrorMessage}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding Statistics.Applications.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock AutomationProperties.AutomationId="StatisticsErrorState" AutomationProperties.Name="{Binding ErrorMessage}" AutomationProperties.HelpText="统计错误状态" MaxWidth="430" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Grid Height="330" Margin="24,16,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="应用排行" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                <TextBlock Text="点击应用，查看窗口明细" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ListBox x:Name="ApplicationList" AutomationProperties.AutomationId="StatisticsApplicationList" AutomationProperties.Name="应用使用排行" ItemsSource="{Binding Statistics.Applications}" SelectedItem="{Binding SelectedApplication, Mode=OneWay}" SelectionChanged="ApplicationList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Duration, Converter={StaticResource ElapsedDurationConverter}}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ProgressBar Style="{StaticResource ShareBar}" AutomationProperties.Name="当日使用时长占比">
                                                <ProgressBar.Value>
                                                    <MultiBinding Converter="{StaticResource ApplicationShareConverter}">
                                                        <Binding Path="Duration"/>
                                                        <Binding Path="DataContext.Statistics.TotalDuration" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ProgressBar.Value>
                                            </ProgressBar>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="窗口标题明细" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedApplication.ProcessName, TargetNullValue=请选择一个应用}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="选择左侧应用，查看使用明细。" Margin="0,16,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedApplication}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ListBox AutomationProperties.AutomationId="StatisticsTitleList" AutomationProperties.Name="窗口标题使用明细" ItemsSource="{Binding SelectedApplication.WindowTitles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowTitle}"/>
                                            <TextBlock Text="{Binding Duration, Converter={StaticResource ElapsedDurationConverter}}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
                <Border Margin="24,0,24,0">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,6,0,0">
                        <Expander Header="更多统计" AutomationProperties.AutomationId="StatisticsFactsExpander">
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12,8,12,12">
                                    <TextBlock Text="时间与分类" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding Facts.DeepNightDuration, Converter={StaticResource ElapsedDurationConverter}, StringFormat=深夜使用：{0}}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding CategorySummary}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="小时分布" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                                    <TextBlock Text="{Binding HourlySummary}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="与桌宠的互动" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                                    <TextBlock Text="{Binding InteractionSummary}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="AI 记录" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                                    <TextBlock Text="{Binding AiSummary}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

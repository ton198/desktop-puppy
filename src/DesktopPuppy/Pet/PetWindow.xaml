<Window x:Class="DesktopPuppy.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Puppy"
        AutomationProperties.AutomationId="PetWindow"
        AutomationProperties.Name="Desktop Puppy"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="PetWindow_OnMouseLeftButtonDown"
        MouseMove="PetWindow_OnMouseMove"
        MouseLeftButtonUp="PetWindow_OnMouseLeftButtonUp"
        MouseRightButtonDown="PetWindow_OnMouseRightButtonDown">
    <Canvas x:Name="PetRoot" ClipToBounds="True" AutomationProperties.AutomationId="PetSurface">
        <Image x:Name="PetImage" Width="132" Height="132" Stretch="Uniform"
               AutomationProperties.AutomationId="PetAnimation" AutomationProperties.Name="idle" />
    </Canvas>
</Window>

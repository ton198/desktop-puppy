<Window x:Class="DesktopPuppy.Pet.Ai.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 设置" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        AutomationProperties.AutomationId="AiSettingsWindow" Background="#FFF8FAFC">
    <StackPanel x:Name="SettingsPanel" Margin="24">
        <TextBlock Text="右键 AI 台词" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="DeepSeek 生成候选，Jev 选择台词。请求会发送当前应用名、窗口标题和近期台词摘要。" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <CheckBox x:Name="AiEnabled" Content="启用 AI" AutomationProperties.AutomationId="AiEnabled" Margin="0,0,0,8"/>
        <CheckBox x:Name="RightClickEnabled" Content="启用右键 AI 互动" AutomationProperties.AutomationId="RightClickAiEnabled" Margin="0,0,0,12"/>
        <Button Content="保存开关设置" Click="SaveSettings_OnClick" HorizontalAlignment="Left" Padding="12,6" AutomationProperties.AutomationId="SaveAiSettings"/>
        <TextBlock Text="DeepSeek API Key" FontWeight="SemiBold" Margin="0,20,0,6"/>
        <TextBlock x:Name="DeepSeekStatus" AutomationProperties.AutomationId="DeepSeekKeyStatus" Margin="0,0,0,6"/>
        <PasswordBox x:Name="DeepSeekKey" AutomationProperties.AutomationId="DeepSeekKeyInput" Padding="6"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="保存 / 替换" Tag="DeepSeek" Click="SaveKey_OnClick" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="删除 Key" Tag="DeepSeek" Click="DeleteKey_OnClick" Padding="12,6"/>
        </StackPanel>
        <TextBlock Text="Jev API Key" FontWeight="SemiBold" Margin="0,20,0,6"/>
        <TextBlock x:Name="JevStatus" AutomationProperties.AutomationId="JevKeyStatus" Margin="0,0,0,6"/>
        <PasswordBox x:Name="JevKey" AutomationProperties.AutomationId="JevKeyInput" Padding="6"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="保存 / 替换" Tag="Jev" Click="SaveKey_OnClick" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="删除 Key" Tag="Jev" Click="DeleteKey_OnClick" Padding="12,6"/>
        </StackPanel>
        <TextBlock Text="Key 仅以当前 Windows 用户的加密密文保存，不会回显。清理历史不会删除 Key。" TextWrapping="Wrap" Margin="0,20,0,8" Foreground="#FF475569"/>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="AiSettingsStatus" TextWrapping="Wrap" MinHeight="24"/>
    </StackPanel>
</Window>
